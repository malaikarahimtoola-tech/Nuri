<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>nuri. Recipe Studio</title>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --cream: #FAF6F0; --warm-beige: #F0E8DC; --border: #E4D9CC;
  --brown: #5C3D2E; --tan: #C4A882;
  --green-dark: #3A6B4A;
  --sage: #7A9E7E; --rose: #C47A7A; --clay: #B8845A;
  --text: #2C1810; --text-mid: #6B4D3C; --text-light: #9C7B6A;
  --white: #FFFFFF;
  --shadow: 0 2px 12px rgba(44,24,16,0.08);
  --shadow-md: 0 4px 24px rgba(44,24,16,0.12);
  --radius: 14px; --radius-sm: 8px;
  --font-serif: 'Playfair Display', Georgia, serif;
  --font-logo: 'Lora', Georgia, serif;
  --font-body: 'DM Sans', system-ui, sans-serif;
}
html { font-size: 16px; -webkit-font-smoothing: antialiased; }
body { background: var(--cream); color: var(--text); font-family: var(--font-body); min-height: 100vh; }

/* ── NAV ── */
.nav { position: sticky; top: 0; z-index: 100; background: rgba(250,246,240,0.97); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border); padding: 0 32px; height: 64px; display: flex; align-items: center; justify-content: space-between; }
.nav-logo { font-family: var(--font-logo); font-size: 22px; font-weight: 700; color: var(--green-dark); display: inline-flex; align-items: flex-end; }
.nav-logo-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--rose); margin-left: 2px; margin-bottom: 2px; }
.nav-tag { font-family: var(--font-body); font-size: 11px; font-weight: 300; letter-spacing: 0.1em; text-transform: uppercase; color: var(--tan); margin-left: 10px; }
.nav-right { display: flex; align-items: center; gap: 12px; }
.nav-btn { padding: 8px 18px; border-radius: 50px; font-family: var(--font-body); font-size: 13px; font-weight: 500; cursor: pointer; border: none; transition: all 0.18s; }
.nav-btn-ghost { background: transparent; border: 1.5px solid var(--border); color: var(--text-mid); }
.nav-btn-ghost:hover { border-color: var(--brown); color: var(--brown); }
.nav-btn-primary { background: var(--brown); color: white; }
.nav-btn-primary:hover { background: #4A3024; }

/* ── LOGIN ── */
.login-wrap { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
.login-card { background: var(--white); border-radius: 20px; padding: 48px; width: 100%; max-width: 400px; box-shadow: var(--shadow-md); text-align: center; }
.login-leaf { font-size: 40px; margin-bottom: 16px; }
.login-title { font-family: var(--font-serif); font-size: 32px; font-style: italic; color: var(--text); margin-bottom: 6px; }
.login-sub { font-size: 13px; color: var(--text-light); margin-bottom: 32px; }
.login-input { width: 100%; padding: 13px 16px; border: 1.5px solid var(--border); border-radius: var(--radius-sm); font-family: var(--font-body); font-size: 15px; color: var(--text); outline: none; margin-bottom: 14px; background: var(--cream); }
.login-input:focus { border-color: var(--brown); }
.login-btn { width: 100%; padding: 14px; background: var(--brown); color: white; border: none; border-radius: 50px; font-family: var(--font-body); font-size: 15px; font-weight: 600; cursor: pointer; }
.login-btn:hover { background: #4A3024; }
.login-error { color: #C0392B; font-size: 13px; margin-top: 10px; }

/* ── LAYOUT ── */
.admin-wrap { max-width: 1100px; margin: 0 auto; padding: 40px 24px 80px; }
.admin-header { margin-bottom: 36px; }
.admin-header h1 { font-family: var(--font-serif); font-size: 36px; font-style: italic; color: var(--text); margin-bottom: 6px; }
.admin-header p { color: var(--text-light); font-size: 14px; }

.tabs { display: flex; gap: 8px; margin-bottom: 32px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
.tab { padding: 10px 20px; border: none; background: none; font-family: var(--font-body); font-size: 14px; font-weight: 500; color: var(--text-light); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; transition: all 0.15s; }
.tab.active { color: var(--brown); border-bottom-color: var(--brown); font-weight: 600; }
.tab:hover:not(.active) { color: var(--text-mid); }

/* ── FORM ── */
.form-card { background: var(--white); border-radius: var(--radius); padding: 32px; box-shadow: var(--shadow); }
.form-section { margin-bottom: 28px; }
.form-section-title { font-family: var(--font-serif); font-size: 18px; font-weight: 600; color: var(--text); margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
.form-group.full { grid-column: 1 / -1; }
.form-label { font-size: 11px; font-weight: 600; color: var(--text-mid); letter-spacing: 0.06em; text-transform: uppercase; }
.form-input, .form-select, .form-textarea {
  padding: 10px 14px; border: 1.5px solid var(--border); border-radius: var(--radius-sm);
  background: var(--cream); font-family: var(--font-body); font-size: 14px; color: var(--text);
  outline: none; width: 100%; transition: border-color 0.15s;
}
.form-input:focus, .form-select:focus, .form-textarea:focus { border-color: var(--brown); background: white; }
.form-textarea { resize: vertical; line-height: 1.6; min-height: 90px; }
.form-hint { font-size: 11px; color: var(--text-light); margin-top: 3px; line-height: 1.5; }

/* ── HEALTH LABELS ── */
.label-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.label-chip { padding: 7px 14px; border-radius: 50px; border: 1.5px solid var(--border); background: var(--white); font-size: 12px; font-weight: 500; color: var(--text-mid); cursor: pointer; transition: all 0.15s; user-select: none; }
.label-chip:hover { border-color: var(--tan); }
.label-chip.active { border-color: var(--brown); background: var(--warm-beige); color: var(--brown); font-weight: 600; }

/* ── DYNAMIC LISTS ── */
.list-row { display: flex; gap: 8px; margin-bottom: 8px; align-items: center; }
.list-num { width: 26px; height: 26px; border-radius: 50%; background: var(--warm-beige); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: var(--brown); flex-shrink: 0; }
.list-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--tan); flex-shrink: 0; }
.remove-btn { width: 28px; height: 28px; border-radius: 50%; border: 1.5px solid var(--border); background: white; cursor: pointer; color: var(--text-light); font-size: 14px; flex-shrink: 0; transition: all 0.15s; }
.remove-btn:hover { border-color: #C0392B; color: #C0392B; }
.add-btn { display: flex; align-items: center; gap: 8px; padding: 8px 14px; background: var(--warm-beige); border: 1.5px dashed var(--border); border-radius: var(--radius-sm); font-size: 13px; color: var(--text-mid); cursor: pointer; font-family: var(--font-body); width: 100%; margin-top: 4px; transition: all 0.15s; }
.add-btn:hover { border-color: var(--brown); color: var(--brown); }

/* ── EMOJI PICKER ── */
.emoji-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.emoji-btn { width: 44px; height: 44px; border-radius: 10px; border: 2px solid var(--border); background: var(--white); font-size: 22px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.15s; }
.emoji-btn:hover { transform: scale(1.1); border-color: var(--tan); }
.emoji-btn.active { border-color: var(--brown); background: var(--warm-beige); }

/* ── DIETICIAN PICKER ── */
.rd-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
.rd-card { padding: 14px; border-radius: var(--radius-sm); border: 2px solid var(--border); background: var(--white); cursor: pointer; transition: all 0.15s; display: flex; align-items: center; gap: 10px; }
.rd-card:hover { border-color: var(--tan); }
.rd-card.active { border-color: var(--brown); background: var(--warm-beige); }
.rd-avatar-sm { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: white; flex-shrink: 0; }
.rd-name { font-weight: 600; font-size: 14px; color: var(--text); }
.rd-creds { font-size: 11px; color: var(--text-light); }

/* ── SUBMIT ── */
.submit-row { display: flex; gap: 12px; align-items: center; justify-content: flex-end; margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--border); }
.submit-btn { padding: 13px 36px; background: var(--brown); color: white; border: none; border-radius: 50px; font-family: var(--font-body); font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
.submit-btn:hover { background: #4A3024; transform: translateY(-1px); }
.submit-btn:disabled { opacity: 0.4; cursor: default; transform: none; }
.cancel-btn { padding: 13px 24px; background: transparent; border: 1.5px solid var(--border); color: var(--text-mid); border-radius: 50px; font-family: var(--font-body); font-size: 14px; font-weight: 500; cursor: pointer; transition: all 0.15s; }
.cancel-btn:hover { border-color: var(--brown); color: var(--brown); }

/* ── TOAST ── */
.toast { position: fixed; bottom: 32px; right: 32px; background: var(--green-dark); color: white; padding: 14px 24px; border-radius: 50px; font-size: 14px; font-weight: 500; box-shadow: var(--shadow-md); animation: slideUp 0.3s ease; z-index: 999; }
@keyframes slideUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

/* ── RECIPE LIST ── */
.recipe-list { display: flex; flex-direction: column; gap: 12px; }
.recipe-row { background: var(--white); border-radius: var(--radius-sm); padding: 18px 20px; display: flex; align-items: center; gap: 16px; box-shadow: var(--shadow); }
.recipe-emoji { font-size: 28px; flex-shrink: 0; }
.recipe-info { flex: 1; min-width: 0; }
.recipe-title { font-family: var(--font-serif); font-size: 17px; font-style: italic; font-weight: 600; color: var(--text); }
.recipe-meta { font-size: 12px; color: var(--text-light); margin-top: 3px; }
.recipe-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
.recipe-tag { padding: 2px 10px; border-radius: 50px; font-size: 11px; font-weight: 500; background: var(--warm-beige); color: var(--text-mid); }
.recipe-source { font-size: 11px; padding: 3px 10px; border-radius: 50px; background: var(--warm-beige); color: var(--text-light); flex-shrink: 0; }
.recipe-source.custom { background: #C8E6C4; color: #2E6B3E; font-weight: 600; }
.action-btn { padding: 7px 14px; border: 1.5px solid var(--border); border-radius: 50px; background: white; color: var(--text-light); font-size: 12px; font-weight: 500; cursor: pointer; flex-shrink: 0; font-family: var(--font-body); transition: all 0.15s; }
.action-btn:hover { border-color: var(--brown); color: var(--brown); }
.action-btn.danger:hover { border-color: #C0392B; color: #C0392B; }
.empty-state { text-align: center; padding: 48px; color: var(--text-light); font-size: 14px; }

/* ── COLOUR SWATCHES ── */
.color-grid { display: flex; flex-wrap: wrap; gap: 10px; }
.color-swatch { width: 36px; height: 36px; border-radius: 50%; cursor: pointer; border: 3px solid transparent; transition: all 0.15s; }
.color-swatch.active { border-color: var(--brown); box-shadow: 0 0 0 2px var(--brown); }

/* ── IMAGE PREVIEW ── */
.img-preview { width: 100%; height: 160px; object-fit: cover; border-radius: var(--radius-sm); border: 1.5px solid var(--border); margin-top: 8px; display: none; }
.img-preview.visible { display: block; }

@media (max-width: 640px) {
  .form-grid { grid-template-columns: 1fr; }
  .admin-wrap { padding: 24px 16px 80px; }
  .rd-grid { grid-template-columns: 1fr 1fr; }
  .tabs { gap: 4px; }
  .tab { padding: 8px 12px; font-size: 13px; }
}
</style>
</head>
<body>
<div id="app"></div>
<script>
const ADMIN_PASSWORD = 'nuri2025'
const STORAGE_KEY = 'nuri_custom_recipes'
const RD_STORAGE_KEY = 'nuri_custom_dieticians'

const HEALTH_LABELS = [
  { id: 'pcos', label: 'PCOS' },
  { id: 'endometriosis', label: 'Endometriosis' },
  { id: 'hormones', label: 'Hormones' },
  { id: 'fertility', label: 'Fertility' },
  { id: 'gut', label: 'Gut Health' },
  { id: 'thyroid', label: 'Thyroid' },
  { id: 'period', label: 'Period Health' },
  { id: 'energy', label: 'Energy' },
  { id: 'postpartum', label: 'Postpartum' },
  { id: 'menopause', label: 'Menopause' },
  { id: 'anti-inflammatory', label: 'Anti-Inflammatory' },
  { id: 'high-protein', label: 'High Protein' },
  { id: 'gut-friendly', label: 'Gut-Friendly' },
]

const EMOJIS = ['🥗','🍲','🥣','🍳','🥘','🫐','🍞','🥙','🌮','🍜','🥬','🐟','🍛','🫙','🧆','🍵','🥤','🍫','⚡','💜','✨','🌿','🍋','🥑','🎃','🥕','🥞','🍆','🥚','🔴','🍰','🌶️','🍂','🥭','🥜','🌈','🍝','🖤']

const AVATAR_COLORS = ['#7A9E7E','#C47A7A','#C4A882','#B8845A','#9B7BAA','#8FA888','#D4A5A5','#B8A0C8','#A0B8D4','#C8A060']

// Built-in RDs — must match IDs in index.html
const BUILT_IN_RDS = [
  { id: 1, name: 'Emily', credentials: 'Co-founder', specialty: "Women's Health Nutrition", avatarColor: '#C4A882' },
  { id: 2, name: 'Malaika', credentials: 'Co-founder', specialty: "Women's Health Nutrition", avatarColor: '#8FA888' },
  { id: 3, name: 'Claire Pettitt', credentials: 'PhD, RD', specialty: 'PCOS & Women\'s Health', avatarColor: '#7A9E7E' },
  { id: 4, name: 'Alysse Vocca', credentials: 'RD', specialty: 'Eating Disorders & Women\'s Health', avatarColor: '#C47A7A' },
]

const GINGHAM_COLORS = [
  { label: 'Sage',  bg: '#A8C4A8', s: 'rgba(58,107,74,0.32)' },
  { label: 'Rose',  bg: '#D9A0A0', s: 'rgba(160,60,60,0.30)' },
  { label: 'Tan',   bg: '#D4B87A', s: 'rgba(140,95,20,0.34)' },
  { label: 'Clay',  bg: '#C8A080', s: 'rgba(140,80,30,0.32)' },
  { label: 'Plum',  bg: '#BBA8CC', s: 'rgba(90,50,130,0.28)' },
  { label: 'Cream', bg: '#EDD9A3', s: 'rgba(140,95,20,0.28)' },
  { label: 'Blush', bg: '#EDCACA', s: 'rgba(155,52,68,0.30)' },
  { label: 'Sky',   bg: '#B6CAE0', s: 'rgba(20,48,108,0.26)' },
]

// ── STATE ──
let isLoggedIn = false
let activeTab = 'add'
let toast = null
let editingId = null

let recipeForm = emptyRecipeForm()
let rdForm = emptyRdForm()

function emptyRecipeForm() {
  return {
    title: '', subtitle: '', emoji: '🥗',
    dieticianId: 3, // default to Claire
    healthLabels: ['pcos'], // default to PCOS
    prepTime: '', cookTime: '', servings: '',
    ginghamBg: GINGHAM_COLORS[0].bg,
    ginghamS: GINGHAM_COLORS[0].s,
    photoUrl: '',
    ingredients: [''],
    instructions: [''],
    note: '',
  }
}

function emptyRdForm() {
  return { name: '', credentials: '', specialty: '', bio: '', initials: '', avatarColor: AVATAR_COLORS[0], tags: [] }
}

function getCustomRecipes() {
  try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]') } catch { return [] }
}
function getCustomRDs() {
  try { return JSON.parse(localStorage.getItem(RD_STORAGE_KEY) || '[]') } catch { return [] }
}

function saveRecipe() {
  let recipes = getCustomRecipes()
  if (editingId) {
    recipes = recipes.map(r => r.id === editingId ? { ...recipeForm, id: editingId, custom: true } : r)
    showToast('Recipe updated ✓')
    editingId = null
  } else {
    recipes.push({ ...recipeForm, id: Date.now(), custom: true })
    showToast('Recipe added to app ✓')
  }
  localStorage.setItem(STORAGE_KEY, JSON.stringify(recipes))
  recipeForm = emptyRecipeForm()
  activeTab = 'recipes'
  render()
}

function editRecipe(id) {
  const recipe = getCustomRecipes().find(r => r.id === id)
  if (!recipe) return
  editingId = id
  recipeForm = {
    title: recipe.title || '',
    subtitle: recipe.subtitle || '',
    emoji: recipe.emoji || '🥗',
    dieticianId: recipe.dieticianId || 3,
    healthLabels: recipe.healthLabels || ['pcos'],
    prepTime: recipe.prepTime || '',
    cookTime: recipe.cookTime || '',
    servings: recipe.servings || '',
    ginghamBg: recipe.ginghamBg || GINGHAM_COLORS[0].bg,
    ginghamS: recipe.ginghamS || GINGHAM_COLORS[0].s,
    photoUrl: recipe.photoUrl || '',
    ingredients: recipe.ingredients?.length ? recipe.ingredients : [''],
    instructions: recipe.instructions?.length ? recipe.instructions : [''],
    note: recipe.note || '',
  }
  activeTab = 'add'
  render()
  window.scrollTo(0, 0)
}

function deleteRecipe(id) {
  if (!confirm('Delete this recipe?')) return
  localStorage.setItem(STORAGE_KEY, JSON.stringify(getCustomRecipes().filter(r => r.id !== id)))
  render()
}

function saveRD() {
  const rds = getCustomRDs()
  rds.push({ ...rdForm, id: Date.now(), custom: true, followers: 0, following: 0, recipeIds: [] })
  localStorage.setItem(RD_STORAGE_KEY, JSON.stringify(rds))
  rdForm = emptyRdForm()
  showToast('Dietitian added ✓')
  activeTab = 'dieticians'
  render()
}

function deleteRD(id) {
  if (!confirm('Delete this dietitian?')) return
  localStorage.setItem(RD_STORAGE_KEY, JSON.stringify(getCustomRDs().filter(r => r.id !== id)))
  render()
}

function showToast(msg) {
  toast = msg
  render()
  setTimeout(() => { toast = null; render() }, 3000)
}

// ── RENDER ──
function render() {
  const app = document.getElementById('app')
  if (!isLoggedIn) { app.innerHTML = renderLogin(); bindLogin(); return }
  app.innerHTML = renderAdmin()
  bindAdmin()
}

function renderLogin() {
  return `
    <div class="login-wrap">
      <div class="login-card">
        <div class="login-leaf">🌿</div>
        <div class="login-title">Recipe Studio</div>
        <div class="login-sub" style="font-family:'Lora',serif;font-style:italic;font-size:14px">nuri<span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:#C47A7A;margin-left:1px;margin-bottom:1px;vertical-align:middle"></span></div>
        <div class="login-sub" style="margin-top:8px;margin-bottom:32px">Admin access only</div>
        <input class="login-input" type="password" id="pw-input" placeholder="Enter password" />
        <button class="login-btn" id="pw-btn">Enter Studio →</button>
        <div class="login-error" id="pw-error" style="display:none">Incorrect password.</div>
      </div>
    </div>`
}

function bindLogin() {
  const btn = document.getElementById('pw-btn')
  const input = document.getElementById('pw-input')
  const error = document.getElementById('pw-error')
  function tryLogin() {
    if (input.value === ADMIN_PASSWORD) { isLoggedIn = true; render() }
    else { error.style.display = 'block'; input.value = ''; input.focus() }
  }
  btn.addEventListener('click', tryLogin)
  input.addEventListener('keydown', e => { if (e.key === 'Enter') tryLogin() })
  input.focus()
}

function renderAdmin() {
  const customRecipes = getCustomRecipes()
  const customRDs = getCustomRDs()
  const allRDs = [...BUILT_IN_RDS, ...customRDs.map(r => ({ id: r.id, name: r.name, credentials: r.credentials, specialty: r.specialty, avatarColor: r.avatarColor }))]

  return `
    <nav class="nav">
      <div style="display:flex;align-items:center;gap:4px">
        <span class="nav-logo">nuri<span class="nav-logo-dot"></span></span>
        <span class="nav-tag">Recipe Studio</span>
      </div>
      <div class="nav-right">
        <a href="index.html" target="_blank"><button class="nav-btn nav-btn-ghost">View app ↗</button></a>
        <button class="nav-btn nav-btn-ghost" onclick="isLoggedIn=false;render()">Sign out</button>
      </div>
    </nav>

    <div class="admin-wrap">
      <div class="admin-header">
        <h1>${editingId ? 'Editing Recipe' : 'Recipe Studio'}</h1>
        <p>Add and manage recipes that appear in the nuri. app — no code needed.</p>
      </div>

      <div class="tabs">
        <button class="tab ${activeTab==='add'?'active':''}" onclick="editingId=null;recipeForm=emptyRecipeForm();activeTab='add';render()">
          ${editingId ? '✏️ Editing' : '➕ Add Recipe'}
        </button>
        <button class="tab ${activeTab==='paste'?'active':''}" onclick="activeTab='paste';render()">📋 Paste Recipe</button>
        <button class="tab ${activeTab==='recipes'?'active':''}" onclick="activeTab='recipes';render()">🗂 Recipes (${customRecipes.length})</button>
        <button class="tab ${activeTab==='dieticians'?'active':''}" onclick="activeTab='dieticians';render()">👩‍⚕️ Dietitians</button>
        <button class="tab ${activeTab==='add-rd'?'active':''}" onclick="activeTab='add-rd';render()">➕ Add Dietitian</button>
      </div>

      ${activeTab==='add'     ? renderAddRecipe(allRDs) : ''}
      ${activeTab==='paste'   ? renderPaste() : ''}
      ${activeTab==='recipes' ? renderRecipeList(customRecipes, allRDs) : ''}
      ${activeTab==='dieticians' ? renderRDList(customRDs) : ''}
      ${activeTab==='add-rd'  ? renderAddRD() : ''}
    </div>

    ${toast ? `<div class="toast">${toast}</div>` : ''}
  `
}

function renderAddRecipe(allRDs) {
