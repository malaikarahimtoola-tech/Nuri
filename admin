// ── HELPERS ──
function esc(str) {
  return String(str||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
}

function updatePhotoPreview() {
  const img = document.getElementById('photo-preview')
  const input = document.getElementById('f-photo')
  if (!img || !input) return
  const url = input.value.trim()
  if (url) {
    img.src = url
    img.classList.add('visible')
    img.style.display = 'block'
  } else {
    img.classList.remove('visible')
    img.style.display = 'none'
  }
}

function syncForm() {
  const map = [['f-title','title'],['f-subtitle','subtitle'],['f-prep','prepTime'],['f-cook','cookTime'],['f-servings','servings'],['f-note','note'],['f-photo','photoUrl']]
  map.forEach(([id, key]) => { const el = document.getElementById(id); if (el) recipeForm[key] = el.value })
  recipeForm.ingredients.forEach((_, i) => { const el = document.getElementById(`ing-${i}`); if (el) recipeForm.ingredients[i] = el.value })
  recipeForm.instructions.forEach((_, i) => { const el = document.getElementById(`step-${i}`); if (el) recipeForm.instructions[i] = el.value })
}

function submitRecipe() {
  syncForm()
  if (!recipeForm.title.trim()) { alert('Please add a recipe title.'); return }
  if (!recipeForm.healthLabels.length) { alert('Please select at least one health condition.'); return }
  saveRecipe()
}

function submitRD() {
  if (!rdForm.name.trim()) { alert('Please add a name.'); return }
  if (!rdForm.credentials.trim()) { alert('Please add credentials.'); return }
  saveRD()
}

function toggleLabel(id) {
  syncForm()
  recipeForm.healthLabels = recipeForm.healthLabels.includes(id)
    ? recipeForm.healthLabels.filter(l => l !== id)
    : [...recipeForm.healthLabels, id]
  render()
}

function toggleRdTag(id) {
  rdForm.tags = rdForm.tags.includes(id) ? rdForm.tags.filter(t => t !== id) : [...rdForm.tags, id]
  render()
}

function addIngredient() {
  syncForm(); recipeForm.ingredients.push(''); render()
  setTimeout(() => { const els = document.querySelectorAll('[id^="ing-"]'); if (els.length) els[els.length-1].focus() }, 50)
}
function removeIngredient(i) { syncForm(); recipeForm.ingredients.splice(i,1); render() }
function addInstruction() {
  syncForm(); recipeForm.instructions.push(''); render()
  setTimeout(() => { const els = document.querySelectorAll('[id^="step-"]'); if (els.length) els[els.length-1].focus() }, 50)
}
function removeInstruction(i) { syncForm(); recipeForm.instructions.splice(i,1); render() }

function autoInitials() {
  const name = document.getElementById('rd-name')?.value || ''
  const parts = name.trim().split(' ').filter(Boolean)
  rdForm.initials = parts.length >= 2
    ? (parts[0][0] + parts[parts.length-1][0]).toUpperCase()
    : parts[0]?.slice(0,2).toUpperCase() || ''
  rdForm.name = name
  const el = document.getElementById('rd-initials')
  if (el) el.value = rdForm.initials
}

function parseRecipeText(text) {
  const lines = text.split('\n').map(l => l.trim()).filter(Boolean)
  if (!lines.length) return
  let title='', subtitle='', ingredients=[], instructions=[], note='', prepTime='', cookTime='', servings=''
  let mode = 'title'
  const ingKw = /^(ingredients|what you need|you('ll| will) need)/i
  const instKw = /^(instructions|method|directions|steps|how to)/i
  const noteKw = /^(note|tip|chef'?s? note|rd'?s? note|dietitian'?s? note)/i
  lines.forEach((line, i) => {
    if (/prep.{0,10}time/i.test(line)) { prepTime = line.replace(/.*:/,'').trim(); return }
    if (/cook.{0,10}time/i.test(line)) { cookTime = line.replace(/.*:/,'').trim(); return }
    if (/serves?|servings?/i.test(line) && /\d/.test(line)) { servings = line.match(/\d+/)?.[0]||''; return }
    if (i===0) { title=line; return }
    if (i===1 && line.length<80 && !ingKw.test(line) && !instKw.test(line)) { subtitle=line; return }
    if (ingKw.test(line)) { mode='ingredients'; return }
    if (instKw.test(line)) { mode='instructions'; return }
    if (noteKw.test(line)) { mode='note'; return }
    const clean = line.replace(/^[-•*·▪◦]\s*/,'').replace(/^\d+\.\s*/,'')
    if (mode==='ingredients' && clean) ingredients.push(clean)
    else if (mode==='instructions' && clean) instructions.push(clean)
    else if (mode==='note') note += (note?' ':'')+line
  })
  if (title) recipeForm.title = title
  if (subtitle) recipeForm.subtitle = subtitle
  if (ingredients.length) recipeForm.ingredients = ingredients
  if (instructions.length) recipeForm.instructions = instructions
  if (note) recipeForm.note = note
  if (prepTime) recipeForm.prepTime = prepTime
  if (cookTime) recipeForm.cookTime = cookTime
  if (servings) recipeForm.servings = servings
  showToast('Auto-filled — check and adjust ✓')
  activeTab = 'add'
  render()
}

